# Generated by `elyaeval init-ci` (elyaeval {elyaeval_version}). Commit it to this mission repo.
#
# Runs the shared `elyaeval` Tekton Pipeline against THIS repo. The Pipeline
# and its Tasks are installed once per cluster/namespace from the elyaeval
# package itself (same version as this file):
#
#     elyaeval ci apply -n {namespace}
#
# The app under test must ALREADY be running and reachable from inside the
# cluster at $SUT_URL (Docker Desktop / kind: http://host.docker.internal:<port>).
#
# Set the machine-specific values, then create a run (PowerShell; bash: export VAR=...):
#
#   $env:REPO_URL         = "https://github.com/<you>/<this-repo>.git"   # only if repo-url below is ${{REPO_URL}}
#   $env:SUT_URL          = "http://host.docker.internal:8000"
#   $env:JUDGE_PROVIDER   = "ollama"      # ollama | openai | anthropic | azure_openai | gemini | bedrock | ...
#   $env:JUDGE_MODEL_NAME = "llama3.1"
#   $env:JUDGE_BASE_URL   = "http://host.docker.internal:11434"   # "" for hosted providers (must be set)
#   envsubst < {output_name} | kubectl create -n {namespace} -f -
#
# Secrets the run reads (create once per namespace):
#   judge-model-credentials   key api-key            the judge's API key (any placeholder for local judges)
#   blob-storage-credentials  key connection-string  Azure Storage (or Azurite) connection string
apiVersion: tekton.dev/v1
kind: PipelineRun
metadata:
  generateName: {name_prefix}-
spec:
  pipelineRef:
    name: elyaeval
  timeouts:
    pipeline: "{timeout}"
  params:
    - name: repo-url
      value: {repo_url}
    - name: revision
      value: {revision}
    - name: sut-path
      value: "{sut_path}"
    - name: test-file
      value: {test_file}
    - name: sut-url
      value: ${{SUT_URL}}
    - name: runner-image
      value: {runner_image}
    - name: judge-provider
      value: ${{JUDGE_PROVIDER}}
    - name: judge-model-name
      value: ${{JUDGE_MODEL_NAME}}
    - name: judge-model-base-url
      value: ${{JUDGE_BASE_URL}}
    - name: blob-container
      value: {blob_container}
    - name: ci-stage
      value: "{ci_stage}"
    - name: budget-seconds
      value: "{budget_seconds}"
    # "true" on ONE deliberate run to create/replace the regression baseline
    # (only promoted if every gate passes), then back to "false".
    - name: promote-baseline
      value: "false"
    # Optional (see `elyaeval ci render` -> pipeline.yaml for every param):
    # - name: repeats                      # e.g. nightly: measure judge noise
    #   value: "3"
    # - name: budget-usd
    #   value: "2.00"
    # - name: judge-max-calls-per-minute   # rate-limited free tiers
    #   value: "30"
    # - name: regression-tolerance
    #   value: "0.02"
    # Component suites (they import the app in-process) also need:
    # - name: sut-requirements-file
    #   value: requirements.txt
    # - name: sut-env-secret-name          # Secret with the app's own env vars/keys
    #   value: <your-app>-env
  workspaces:
    - name: source
      volumeClaimTemplate:
        spec:
          accessModes: [ReadWriteOnce]
          resources:
            requests:
              storage: 1Gi
