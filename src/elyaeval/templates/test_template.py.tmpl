# Your goldens file must match the schema in elyaeval.core.dataset's
# GOLDEN_SCHEMA (also documented in the main README's "Goldens file
# schema" section)   load_standard_dataset() validates the whole file
# upfront and raises GoldenValidationError listing every problem found
# before generating any test cases.
# ci_stage is cumulative (nightly = per_commit + merge + nightly goldens) and
# can be overridden per run with ELYAEVAL_CI_STAGE, e.g. per_commit in PR CI.
GOLDENS = load_standard_dataset(task_type="{task_type}", ci_stage=resolve_stage("{ci_stage}"))


@pytest.mark.parametrize(
    "golden",
    GOLDENS,
    ids=[golden_id(g) for g in GOLDENS],
)
def test_{task_type}(golden):
    started = time.perf_counter()
    run_result = run_app(golden.input)
    # SUT usage for budgets/ledger: whatever run_app() reported (tokens,
    # cost) plus the measured latency if it didn't report one
    usage = run_result.usage or SUTUsage()
    if usage.latency_seconds is None:
        usage = usage._replace(latency_seconds=time.perf_counter() - started)

    test_case = LLMTestCase(
        input=golden.input,
        actual_output=run_result.actual_output,
        expected_output=golden.expected_output,
        context=golden.context,
        retrieval_context=run_result.retrieval_context,
    )

    # One evaluate() call per golden (test_cases=[test_case], never the
    # whole GOLDENS list)   keeps scoring per-golden and gives each a
    # clean row (or rows, one per metric) in REPORT_CSV, keyed by the golden's
    # stable id. The metric factory is called per golden so every golden gets
    # fresh metric instances, scored by the configured judge (see
    # [tool.elyaeval.judge] / ELYAEVAL_JUDGE_* or `elyaeval judge`).
    result = evaluate_golden(
        golden, test_case, metrics_for_golden(golden, {metrics_factory}), csv_path=REPORT_CSV, sut_usage=usage
    )
    assert result.success, f"{{result.name}} failed   see {{REPORT_CSV}} for per-metric scores"
