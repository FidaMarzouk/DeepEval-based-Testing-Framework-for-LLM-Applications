import os
import time

import pytest
from deepeval.test_case import LLMTestCase

from elyaeval import evaluate_golden, load_standard_dataset, new_report_path
from elyaeval.core.agentic import agent_action_metrics_for_golden, expected_tools_from_golden, tool_calls_from_json
from elyaeval.core.dataset import golden_id
from elyaeval.core.metrics import qa_correctness_metrics
from elyaeval.core.run_contracts import AgenticRunResult, SUTUsage
from elyaeval.core.stages import resolve_stage

APP_URL = os.environ.get("APP_URL", "http://localhost:8000").rstrip("/")
REPORT_CSV = new_report_path("{task_type}")


def run_app(user_input: str) -> AgenticRunResult:
    """
    TODO 1-2: call your agent and return an AgenticRunResult.

    Over HTTP (the agent's API returns its answer and the tools it called):

        import requests
        data = requests.post(f"{{APP_URL}}/chat", json={{"message": user_input}}, timeout=600).json()
        return AgenticRunResult(
            actual_output=data["answer"],
            tools_called=tool_calls_from_json(data["tool_calls"]),   # [{{name, input_parameters|args, output}}]
            usage=SUTUsage(input_tokens=data["usage"]["input_tokens"], output_tokens=data["usage"]["output_tokens"]),
        )

    Or in-process:
        result = run_agent(user_input)
        return AgenticRunResult(actual_output=result.answer, tools_called=tool_calls_from_json(result.tool_calls))
    """
    raise NotImplementedError("Wire this up to your agent before running the suite.")


GOLDENS = load_standard_dataset(task_type="{task_type}", ci_stage=resolve_stage("{ci_stage}"))


@pytest.mark.parametrize("golden", GOLDENS, ids=[golden_id(g) for g in GOLDENS])
def test_{task_type}(golden):
    started = time.perf_counter()
    run_result = run_app(golden.input)
    usage = run_result.usage or SUTUsage()
    if usage.latency_seconds is None:
        usage = usage._replace(latency_seconds=time.perf_counter() - started)

    test_case = LLMTestCase(
        input=golden.input,
        actual_output=run_result.actual_output,
        expected_output=golden.expected_output,
        tools_called=run_result.tools_called,
        expected_tools=expected_tools_from_golden(golden),
    )
    # tool metrics + guards for every golden; answer correctness only when the
    # golden has a reference answer
    metrics = agent_action_metrics_for_golden(
        golden, action_metrics=qa_correctness_metrics if golden.expected_output else None
    )
    result = evaluate_golden(golden, test_case, metrics, csv_path=REPORT_CSV, sut_usage=usage)
    assert result.success, f"{{golden_id(golden)}} failed   see {{REPORT_CSV}} for per-metric scores"
