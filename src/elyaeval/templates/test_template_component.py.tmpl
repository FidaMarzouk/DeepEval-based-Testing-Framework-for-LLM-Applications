from pathlib import Path

from deepeval.dataset import Golden
import pytest

from elyaeval import load_standard_dataset, new_report_path
from elyaeval.core.dataset import golden_id
from elyaeval.core.metrics import generation_metrics, retrieval_metrics
from elyaeval.core.stages import resolve_stage
from elyaeval.reporting.tracing_report import (
    TracedRunner,
    append_traced_csv_rows,
    failed_results,
    traced_test_result_to_csv_rows,
)

REPORT_CSV = new_report_path("{task_type}_component")

# TODO 1: import your app's traced entrypoint, in-process, e.g.:
# from rag_core import run_for_eval

# TODO 3: span name -> metric factory (called per golden: fresh instances,
# configured judge). Names are your @observe'd functions' names.
SPAN_METRICS = {{
    "retrieve": retrieval_metrics,
    "generate_answer": generation_metrics,
}}

# Trace-level metrics (judged against the WHOLE call). Leave empty unless
# your entrypoint calls update_current_trace(input=..., output=...).
TRACE_METRICS = []


def call_sut(golden: Golden) -> None:
    """
    TODO 2: call your app's traced entrypoint here, in-process.

    Must be a plain call that runs your app for `golden.input`   nothing
    needs to be returned. DeepEval reads the SUT's output back off the
    span/trace it recorded via @observe + update_current_span/
    update_current_trace, not off this function's return value.

    e.g.:
        def call_sut(golden):
            run_for_eval(golden.input)   # the reference answer comes from the golden, not the app

    This MUST be an in-process import + call (see module docstring for
    why)   there is no HTTP equivalent for this template, unlike
    test_elyaeval_{task_type}.py's run_app().
    """
    raise NotImplementedError("Wire this up to your app's traced entrypoint before running the suite.")


# ci_stage is cumulative (nightly = per_commit + merge + nightly goldens) and
# can be overridden per run with ELYAEVAL_CI_STAGE, e.g. per_commit in PR CI.
GOLDENS = load_standard_dataset(task_type="{task_type}", ci_stage=resolve_stage("{ci_stage}"))


@pytest.mark.parametrize(
    "golden",
    GOLDENS,
    ids=[golden_id(g) for g in GOLDENS],
)
def test_{task_type}_component(golden):

    # A fresh single-golden EvaluationDataset per test   never one
    # evals_iterator() call batched over the whole GOLDENS list   so this
    # stays one pytest test per golden, one CSV append per golden, exactly
    # like the e2e template's one evaluate_golden() call per golden.
    result = TracedRunner(golden, metrics=TRACE_METRICS, span_metrics=SPAN_METRICS).run(call_sut)

    gid = golden_id(golden)
    priority = (golden.additional_metadata or {{}}).get("priority", "")

    rows = []
    for test_result in result.test_results:
        rows.extend(traced_test_result_to_csv_rows(gid, priority, test_result))
    append_traced_csv_rows(REPORT_CSV, rows)

    # failed_results() judges each span by its metrics, not tr.success (which
    # DeepEval 4.2.0 always sets False for spans   see its docstring).
    failed = failed_results(result)
    assert not failed, f"span(s) failed: {{failed}}   see {{REPORT_CSV}} for per-metric scores"
